# Copy to .env and replace every placeholder locally. Never commit .env.

AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_INDEX=<search-index-name>
FOUNDRY_KB_PROFILE=custom
FOUNDRY_CUSTOM_KB_NAME=<custom-knowledge-base-name>
FOUNDRY_BASELINE_KB_NAME=<baseline-knowledge-base-name>
KB_API_VERSION=<supported-knowledge-base-api-version>

AZURE_OPENAI_ENDPOINT=https://<ai-services-account-name>.openai.azure.com
AZURE_OPENAI_API_VERSION=<supported-openai-api-version>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat-deployment-name>

FOUNDRY_PROJECT_ENDPOINT=https://<ai-services-account-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL=<chat-deployment-name>

# Required only when compiling or deploying infra/main.bicepparam.
# Keep this JSON on one line so dotenv loaders preserve it. Use a private immutable Blob without a SAS.
CUSTOM_SEARCH_SETTINGS_JSON={"functionAppName":"<function-app-name>","functionStorageName":"<function-storage-account-name>","functionPlanName":"<function-plan-name>","functionLocation":"<function-app-region>","functionStorageLocation":"<function-storage-region>","functionPackageContainerName":"<package-container-name>","functionAuthClientId":"<entra-application-client-id>","functionAuthAudience":"api://<entra-application-client-id>","functionPackageUri":"https://<package-storage-account-name>.blob.core.windows.net/<package-container-name>/<version>/custom-skill.zip","functionPackageStorageResourceId":"/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.Storage/storageAccounts/<package-storage-account-name>","functionIntegrationSubnetId":"/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.Network/virtualNetworks/<virtual-network-name>/subnets/<subnet-name>","customSkillRoute":"/api/<custom-skill-route>","deploymentVersion":"<immutable-package-version>","indexName":"<custom-index-name>","dataSourceName":"<data-source-name>","skillsetName":"<skillset-name>","indexerName":"<indexer-name>","knowledgeSourceName":"<knowledge-source-name>","knowledgeBaseName":"<custom-knowledge-base-name>","baselineIndexName":"<baseline-index-name>","baselineKnowledgeBaseName":"<baseline-knowledge-base-name>","chunkMaximumTokens":1,"chunkOverlapTokens":0,"tokenizerModelName":"cl100k_base","embeddingModelName":"text-embedding-3-large","embeddingDimensions":3072,"searchApiVersion":"2024-09-01-preview","foundryIqApiVersion":"2026-08-01-preview","tags":{"environment":"<environment-name>"}}

KB_SEARCH_URL=http://localhost:8000/kb/search

# Optional private-Blob citation rewriting. Leave unset to preserve source URIs.
# KB_BLOB_HOST=<storage-account-name>.blob.core.windows.net
# KB_PORTAL_BLOB_PREFIX=<azure-portal-blob-properties-prefix>
